# ── Database ───────────────────────────────────────────────────────────────
# PostgreSQL connection string. Copy to .env and fill in real credentials.
DATABASE_URL="postgresql://postgres:your_password_here@localhost:5432/pilot_fatigue"

# ── Auth.js ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace_with_a_random_32_char_secret"
NEXTAUTH_URL="http://localhost:3000"
